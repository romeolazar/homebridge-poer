{
  "name": "homebridge-poer",
  "displayName": "Poer Smart Thermostat",
  "type": "module",
  "version": "1.0.0",
  "description": "Homebridge platform plugin for Poer Smart Thermostats (PTC10, PTR16, etc.) with Apple HomeKit support.",
  "author": "Romeo Lazar <romeo@hmsc.ro>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/romeolazar/homebridge-poer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romeolazar/homebridge-poer.git"
  },
  "bugs": {
    "url": "https://github.com/romeolazar/homebridge-poer/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "poer",
    "poersmart",
    "thermostat",
    "homekit"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint src/ --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "tsc --watch",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0"
  }
}
